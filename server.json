{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.legis-link/legis-link",
  "title": "Legis-Link",
  "description": "Compliance answers for 10 construction trades in AU, UK, US, CA and EU: codes, licensing, RAMS.",
  "version": "3.31.0",
  "websiteUrl": "https://legis-link.com",
  "repository": {
    "url": "https://github.com/eutech-directory/legis-link-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://legis-link.com/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://legis-link.com/icon-192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    },
    {
      "src": "https://legis-link.com/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://legis-link.com/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Optional Legis-Link Pro key (the licence key from your Gumroad receipt). Leave empty for the free tier.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
